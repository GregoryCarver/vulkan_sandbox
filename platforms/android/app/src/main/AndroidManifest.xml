<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vulkan 1.3 is an explicit initial device tier, independent of minSdk. -->
    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x00403000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level"
        android:version="1" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="Vulkan Sandbox" android:allowBackup="false"
        android:theme="@style/SandboxTheme" android:hasCode="true">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="sandbox_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
