#!/bin/sh
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -f "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" ]; then
    if ! command -v gradle >/dev/null 2>&1; then
        echo "Gradle wrapper JAR has not been bootstrapped. Install Gradle 8.11.1 and JDK 17," >&2
        echo "then run: gradle -p \"$APP_HOME\" wrapper --gradle-version 8.11.1 --distribution-type bin" >&2
        exit 1
    fi
    if ! gradle --version | grep -q '^Gradle 8\.11\.1$'; then
        echo "This project requires Gradle 8.11.1. Generate the pinned wrapper using the documented bootstrap command." >&2
        exit 1
    fi
    exec gradle -p "$APP_HOME" "$@"
fi
if [ -n "${JAVA_HOME:-}" ]; then
    JAVA_EXE="$JAVA_HOME/bin/java"
else
    JAVA_EXE=java
fi
exec "$JAVA_EXE" -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
